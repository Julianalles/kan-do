{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.notion.com/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/settings/**"
        },
        {
          "url": "https://www.notion.so/my-integrations"
        },
        {
          "url": "https://www.notion.so/*"
        },
        {
          "url": "https://app.todoist.com/app/*"
        },
        {
          "url": "https://github.com/jaylouiz/kan-do/issues/*"
        },
        {
          "url": "https://github.com/jaylouiz/kan-do/issues/new*"
        },
        {
          "url": "https://www.julius-wuestefeld.workers.dev/**"
        },
        {
          "url": "https://julius-wuestefeld.de/**"
        },
        {
          "url": "https://www.julius-wuestefeld.de/**"
        },
        {
          "url": "x-apple.systempreferences:com.apple.preference.security?Privacy_Reminders"
        }
      ]
    }
  ]
}
